## Configuration ##

NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_DEFAULT_KEY="your-supabase-publishable-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

SUPERADMIN_EMAIL="admin@example.com"
SUPERADMIN_PASSWORD="secure_password_here"

# db related config
DB_PASSWORD="your-db-password"
DATABASE_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres"
